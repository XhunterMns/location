const fs = require('fs');
const path = require('path');
const { get } = require('./env');

function buildDbSslConfig() {
  const sslEnabled = ['true', '1', 'yes'].includes(String(get('DB_SSL', 'false')).toLowerCase());

  if (!sslEnabled) {
    return undefined;
  }

  const sslConfig = {
    rejectUnauthorized: String(get('DB_SSL_REJECT_UNAUTHORIZED', 'true')).toLowerCase() !== 'false',
  };

  const caValue = String(get('DB_SSL_CA', '')).trim();
  if (!caValue) {
    return sslConfig;
  }

  const candidatePaths = [
    caValue,
    path.resolve(process.cwd(), caValue),
    path.resolve(__dirname, '..', caValue),
    path.resolve(__dirname, '../..', caValue),
  ];

  for (const candidate of candidatePaths) {
    if (fs.existsSync(candidate)) {
      sslConfig.ca = fs.readFileSync(candidate, 'utf8');
      return sslConfig;
    }
  }

  if (caValue.includes('BEGIN CERTIFICATE')) {
    sslConfig.ca = caValue;
    return sslConfig;
  }

  return sslConfig;
}

const APP_CONFIG = {
  port: Number(get('PORT', 3000)),
  jwtSecret: get('JWT_SECRET', 'secret123'),
  bcryptRounds: Number(get('BCRYPT_ROUNDS', 10)),
  cors: {
    origin: true,
    credentials: true,
  },
};
console.log('[CONFIG] DB environment check:', {
  DB_HOST: !!get('DB_HOST'),
  DB_PORT: !!get('DB_PORT'),
  DB_USER: !!get('DB_USER'),
  DB_PASSWORD: !!get('DB_PASSWORD'),
  DB_NAME: !!get('DB_NAME'),
  DB_SSL: get('DB_SSL', 'false'),
  DB_SSL_CA: !!get('DB_SSL_CA'),
});
const DB_CONFIG = {
  host: get('DB_HOST', 'localhost'),
  port: Number(get('DB_PORT', 3306)),
  user: get('DB_USER', 'root'),
  password: get('DB_PASSWORD', ''),
  database: get('DB_NAME', 'location_db'),
  ssl: buildDbSslConfig(),

  waitForConnections: true,
  connectionLimit: Number(get('DB_CONNECTION_LIMIT', 10)),
};

module.exports = {
  APP_CONFIG,
  DB_CONFIG,
};
